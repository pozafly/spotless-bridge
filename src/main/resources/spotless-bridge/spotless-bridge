#!/bin/sh
# Spotless Bridge hook launcher. The Gradle plugin writes it to <gradle-root>/.gradle/spotless-bridge/
# on every Gradle run, so it always matches the plugin version.
# Usage: .gradle/spotless-bridge/spotless-bridge [files...]
# Files are relative to the Gradle root or absolute. Formatting logic lives in the project's engine.
set -eu
[ "$#" -gt 0 ] || exit 0
root=$(cd "$(dirname "$0")/../.." && pwd -P)
runtime="$root/.gradle/spotless-bridge/client-runtime.txt"
jar=$( [ -f "$runtime" ] && sed -n 1p "$runtime" || true)
java_home=$( [ -f "$runtime" ] && sed -n 2p "$runtime" || true)
if [ ! -f "$jar" ] || [ ! -x "$java_home/bin/java" ]; then
    # First use, or the engine was removed with part of .gradle: Gradle prepares the project's engine again.
    (cd "$root" && ./gradlew --console=plain --no-configuration-cache spotlessBridgeStart)
    jar=$(sed -n 1p "$runtime")
    java_home=$(sed -n 2p "$runtime")
fi
exec "$java_home/bin/java" -cp "$jar" io.github.pozafly.spotlessbridge.GradleFormatter --hook "$root" "$@"
